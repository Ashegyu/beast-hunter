      "declarations": "display:flex;align-items:center;justify-content:center;gap:9px;width:calc(100% - 24px);margin:0 12px 15px;padding:12px 12px;min-height:51px;border-radius:26px;border:1px solid #d0ab85;background:linear-gradient(100deg,#461622,#7c2937,#391824)!important;color:#fff0d7;font:500 13px/1.7 var(--serif);box-shadow:inset 0 0 0 3px #dfb28d13,0 0 12px #8d35442b"
    },
