      "declarations": "display:flex;align-items:center;justify-content:center;text-align:center;min-width:0;max-width:100%;position:relative;isolation:isolate;border-color:transparent!important;border-radius:0!important;background:#10181c!important;box-shadow:none!important;text-shadow:0 1px 3px #000;color:#f1e2c7"
    },
    {
      "file": "buttons.css",
      "selector": "#game-shell button.image-button>.button-edge,#game-shell button.centered-action>.button-edge",
      "declarations": "position:absolute;inset-inline-end:var(--button-edge-inset,14px);inset-inline-start:auto;top:50%;transform:translateY(-50%);display:grid;place-items:center;width:var(--button-edge-width,20px);max-width:var(--button-edge-width,20px);margin:0;line-height:1;pointer-events:none"
    },
    {
      "file": "buttons.css",
      "selector": "#game-shell #craft-track",
      "declarations": "--button-label-padding:32px;--button-edge-inset:8px"
    },
